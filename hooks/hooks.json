{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 || exit 0; python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"",
            "commandWindows": "if (-not (Get-Command python -ErrorAction SilentlyContinue)) { exit 0 }; python \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\guard.py\"; exit $LASTEXITCODE",
            "timeout": 10,
            "statusMessage": "Checking always-on rules..."
          }
        ]
      }
    ]
  }
}
